{
  "name": "kalyth",
  "private": true,
  "description": "Kalyth: a persistent, evidence-backed engineering model and decision record for people and coding agents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @kalyth/web e2e && pnpm --filter @kalyth/web e2e:demo",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json && tsc -p apps/web/e2e/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "build": "pnpm --filter @kalyth/web build",
    "mcp:stdio": "node apps/server/src/mcp/stdio.ts",
    "dev:server": "node apps/server/src/http/main.ts",
    "ingest": "node apps/server/src/cli/ingest.ts",
    "project:export": "node apps/server/src/cli/export.ts",
    "project:import": "node apps/server/src/cli/import.ts",
    "dev:web": "pnpm --filter @kalyth/web dev",
    "dev:seed": "node apps/server/src/dev/seed.ts",
    "budget": "node apps/server/src/cli/budget.ts",
    "spike": "node apps/server/src/cli/spike.ts",
    "spike:replay": "node apps/server/src/dev/spike-replay.ts",
    "eval": "node apps/server/src/cli/eval.ts",
    "demo:setup": "node apps/server/src/dev/demo.ts",
    "demo:agent": "node apps/server/src/dev/demo-agent.ts",
    "demo:serve": "node apps/server/src/demo/main.ts",
    "demo:record": "node apps/server/src/demo/record.ts",
    "demo:recording": "node apps/server/src/dev/recording.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
