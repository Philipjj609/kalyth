# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# Provider for the Navigator: mock (default, free), nebius, openrouter, or replay.
KALYTH_PROVIDER=mock
# Your own Nebius Token Factory key; only read when KALYTH_PROVIDER=nebius.
KALYTH_NEBIUS_API_KEY=
# Your own OpenRouter key; only read when KALYTH_PROVIDER=openrouter. Free endpoints only, for
# public repositories and synthetic data: free endpoints may log prompts (ADR 0016).
KALYTH_OPENROUTER_API_KEY=
# Grounding (ADR 0017): set to 1 to accept a Python string literal quoted with the other ASCII
# delimiter, in Python files only. Off by default.
# KALYTH_GROUNDING_PYTHON_STRINGS=1
# Optional overrides
# KALYTH_LEDGER=/absolute/path/to/ledger.sqlite
# KALYTH_RECORD_DIR=.kalyth/recordings
# KALYTH_MODEL_SUMMARIZE=nvidia/nemotron-3-super-120b-a12b
# KALYTH_MODEL_ALTERNATIVES=nvidia/Nemotron-3-Ultra-550b-a55b
