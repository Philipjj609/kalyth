    {
      "op": "createObject",
      "ref": "$neverTrust",
      "type": "knowledge.Principle",
      "stance": "asIs",
      "attributes": {
        "statement": "Do not trust the client: assume players will try to cheat, and decide the game state where they cannot change it.",
        "rationale": "A client runs on the player’s machine, so its code and messages can be modified to report a state the rules do not allow.",
        "scope": "Multiplayer games, the context of the cited article. A narrower scope is open (see the Question on exceptions).",
        "exceptions": []
      },
      "claim": {
        "basis": "imported",
        "supports": [
          {
            "allOf": ["$g1Cheat"]
          }
        ]
      }
    },
    {
      "op": "createObject",
      "ref": "$authServer",
      "type": "knowledge.Pattern",
      "stance": "asIs",
      "attributes": {
        "name": "Authoritative server",
        "aliases": ["dumb clients", "client/server"],
        "problem": "Players can modify their clients to cheat when clients decide the game state.",
        "solution": "Run the game on a server you control. Clients send inputs and display the state the server sends back.",
        "structure": "Clients send inputs to the server; the server applies them to the one true game state and sends the state to every client.",
        "consequences": "Cheating through the client becomes much harder. Without further techniques, each input takes effect only after a round trip, which players perceive as lag."
      },
      "claim": {
        "basis": "imported",
        "supports": [
          {
            "allOf": ["$g1Auth"]
          },
          {
            "allOf": ["$fwClientServer"]
          }
        ]
      }
    },
    {
      "op": "createObject",
      "ref": "$prediction",
      "type": "knowledge.Pattern",
      "stance": "asIs",
      "attributes": {
        "name": "Client-side prediction with server reconciliation",
        "aliases": ["client-side prediction"],
        "problem": "With an authoritative server alone, a player sees the effect of their own input only after a round trip.",
        "solution": "The client applies its own inputs at once, predicting the server’s result. It numbers its inputs, keeps those the server has not yet acknowledged, and re-applies them on top of each authoritative state it receives.",
        "structure": "Client: numbered input queue, local simulation of its own entity. Server: authoritative simulation that reports the last input it processed.",
        "consequences": "Own movement feels immediate. The game must be predictable enough that predictions usually match the server; when they do not, the client corrects to the server’s state."
      },
      "claim": {
        "basis": "imported",
        "supports": [
          {
            "allOf": ["$g2Predict", "$g2Reconcile"]
          }
        ]
      }
    },
    {
      "op": "createObject",
      "ref": "$entityInterp",
      "type": "knowledge.Pattern",
      "stance": "asIs",
      "attributes": {
        "name": "Entity interpolation",
        "aliases": [],
        "problem": "Server updates about other entities arrive at intervals, so drawing them as they arrive makes them jump.",
        "solution": "Show other entities slightly in the past, interpolating between the two most recent states received from the server.",
        "structure": "The client buffers recent server states for each remote entity and renders it between two of them.",
        "consequences": "Remote entities move smoothly, but are shown somewhat behind their current state on the server."
      },
      "claim": {
        "basis": "imported",
        "supports": [
          {
            "allOf": ["$g3Interp"]
          }
        ]
      }
    },
    {
      "op": "createObject",
      "ref": "$deadReckoning",
      "type": "knowledge.Pattern",
      "stance": "asIs",
      "attributes": {
        "name": "Dead reckoning",
        "aliases": ["extrapolation"],
        "problem": "Server updates about other entities arrive at intervals, and something must be shown in between.",
        "solution": "Extrapolate each remote entity from its last known state, for example its position and velocity, until the next update arrives.",
        "structure": "The client predicts remote entities forward from their last update and corrects them when a new one arrives.",
        "consequences": "Works well for entities whose motion is predictable, such as fast cars; for entities that change direction abruptly, the extrapolation is often wrong and must be corrected."
      },
      "claim": {
        "basis": "imported",
        "supports": [
          {
            "allOf": ["$g3Dead"]
          }
        ]
      }
    },
    {
      "op": "createObject",
      "ref": "$lagCompensation",
      "type": "knowledge.Pattern",
      "stance": "asIs",
      "attributes": {
        "name": "Lag compensation",
        "aliases": ["server-side rewind"],
        "problem": "With interpolation and latency, a shooter aims at where a target appeared on their screen, which is not where the target is on the server.",
        "solution": "The server keeps a short history of entity states and evaluates a shot against the world as the shooter saw it when firing.",
        "structure": "Server: recent history of positions; on a shot, it reconstructs the shooter’s view at that moment and resolves the hit there.",
        "consequences": "Shots that hit on the shooter’s screen hit on the server. A target can be hit a moment after reaching cover on their own screen."
      },
      "claim": {
        "basis": "imported",
        "supports": [
          {
            "allOf": ["$g4Lag"]
          }
        ]
      }
    },
    {
      "op": "createObject",
      "ref": "$lockstep",
      "type": "knowledge.Pattern",
      "stance": "asIs",
      "attributes": {
        "name": "Deterministic lockstep",
        "aliases": ["peer-to-peer lockstep", "simultaneous simulation"],
        "problem": "Sending the state of many units over a slow connection costs too much bandwidth.",
        "solution": "Every machine runs the same simulation from the same start; only the players’ commands are exchanged, and each turn is simulated once every machine has its commands.",
        "structure": "Each peer sends its commands for a future turn to all others; every peer simulates turn by turn in the same order.",
        "consequences": "Bandwidth depends on the commands, not on the number of units. Each player waits for the slowest or most lagged player, and any divergence between machines breaks the game."
      },
      "claim": {
        "basis": "imported",
        "supports": [
          {
            "allOf": ["$aoeSim"]
          },
          {
            "allOf": ["$fwLockstep"]
          }
        ]
      }
    },
    {
      "op": "createObject",
      "ref": "$snapshotInterp",
      "type": "knowledge.Pattern",
      "stance": "asIs",
      "attributes": {
        "name": "Snapshot interpolation",
        "aliases": [],
        "problem": "Deterministic lockstep needs a deterministic simulation, which is hard to achieve, for example with floating point across platforms.",
        "solution": "The server sends snapshots of the visual state of the world; the client buffers them briefly and interpolates between them.",
        "structure": "Server: periodic snapshots of the world. Client: an interpolation buffer and rendering between snapshots.",
        "consequences": "No determinism is needed and the client stays smooth; the cost is much higher bandwidth than sending inputs."
      },
      "claim": {
        "basis": "imported",
        "supports": [
          {
            "allOf": ["$fsBackground", "$fsSnapshots"]
          },
          {
            "allOf": ["$fsInterp"]
          }
        ]
      }
    },
    {
      "op": "createObject",
      "ref": "$isDeterministic",
      "type": "knowledge.Condition",
      "stance": "asIs",
      "attributes": {
        "subject": "$deterministic",
        "test": {
          "op": "is",
